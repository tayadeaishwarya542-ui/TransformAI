# ================================================================
# TransformAI Server Environment Configuration Template
# KEEP SECRET: Never commit real production credentials to Git
# ================================================================

# Application Port (Render automatically injects PORT in production)
PORT=5174

# SQLite Persistent Database Path (Optional: defaults to ./data/transformai.db)
# On Render with Persistent Disk mounted at /var/data, set:
# DATABASE_PATH=/var/data/transformai.db
DATABASE_PATH=

# AI Provider API Keys (Stored securely on the server for server-side proxying)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
